FROM alpine:3.22

LABEL maintainer="Tim Rühsen <tim.ruehsen@gmx.de>"

WORKDIR /usr/local

RUN apk add --no-cache \
	git \
	autoconf \
	autoconf-archive \
	automake \
	libtool \
	make \
	flex \
	bison \
	gettext-dev \
	gettext-static \
	gperf \
	gcc \
	build-base \
	musl-dev \
	pkgconf \
	ca-certificates \
	wget \
	patch \
	texinfo \
	gengetopt \
	curl \
	lzip \
	pandoc \
	rsync \
	python3 \
	bc \
	cmake \
	bash \
	m4 \
	findutils \
	tar \
	gzip \
	gmp-dev \
	gmp-static \
	libunistring-dev \
	libunistring-static \
	pcre2-dev \
	pcre2-static \
	nghttp2-dev \
	nghttp2-static \
	libmicrohttpd-dev \
	libmicrohttpd-static \
	linux-headers \
	zlib-dev

ENV PREFIX=/usr/local
ENV PKG_CONFIG_PATH="$PREFIX/lib/pkgconfig" \
    CPPFLAGS="-I$PREFIX/include" \
    LDFLAGS="-L$PREFIX/lib" \
    CFLAGS="-O2 -g"

RUN git clone --recursive https://github.com/coreutils/gnulib.git gnulib
ENV GNULIB_REFDIR=/usr/local/gnulib

# Nettle 4.0 changed the nettle_cipher_func and nettle_hash_func signatures.
# GnuTLS supports it since 3.8.13, but wget2's libwget nettle fallback still
# uses the old hash API, so stay on the latest 3.10 release (supported by both).
RUN wget -c -q -O nettle.tar.gz "https://github.com/gnutls/nettle/archive/refs/tags/nettle_3.10.2_release_20250626.tar.gz" && tar axf nettle.tar.gz && \
	cd nettle* && bash .bootstrap && \
	./configure --disable-shared --enable-static --disable-documentation --prefix=$PREFIX && \
	make -j$(nproc) && make install && cd .. && rm -rf nettle*

RUN wget -q "https://www.gnupg.org/ftp/gcrypt/gnutls/v3.8/gnutls-3.8.13.tar.xz" && \
    tar axf gnutls-3.8.13.tar.xz && \
    cd gnutls-3.8.13/ && \
    PKG_CONFIG_PATH="$PREFIX/lib/pkgconfig:$PREFIX/lib64/pkgconfig" \
    NETTLE_CFLAGS="-I$PREFIX/include" \
    NETTLE_LIBS="-L$PREFIX/lib -lnettle -lhogweed -L$PREFIX/lib" \
    HOGWEED_CFLAGS="-I$PREFIX/include" \
    HOGWEED_LIBS="-L$PREFIX/lib -lhogweed -lnettle -L$PREFIX/lib" \
    ./configure --prefix=$PREFIX \
    --with-nettle-prefix=$PREFIX \
    --disable-shared \
    --enable-static \
    --with-included-libtasn1 \
    --with-included-unistring \
    --without-p11-kit \
    --disable-doc \
    --disable-tests \
    --disable-full-test-suite \
    --disable-tools \
    --disable-cxx \
    --disable-maintainer-mode \
    --disable-libdane \
    --disable-hardware-acceleration \
    --disable-guile \
    --disable-gcc-warnings && \
    make -j$(nproc) && \
    make install && \
    cd .. && \
    rm -rf gnutls-3.8.13/ gnutls-3.8.13.tar.xz

RUN wget -q -O- https://ftp.gnu.org/pub/gnu/libiconv/libiconv-1.18.tar.gz | tar xz
RUN cd libiconv-* && \
    ./configure --disable-shared --enable-static --prefix=$PREFIX && \
    make -j$(nproc) && make install && cd .. && rm -rf libiconv-*

RUN wget -q -O- https://ftp.gnu.org/gnu/libidn/libidn2-latest.tar.gz | tar xz
RUN cd libidn2-* && \
    ./configure --disable-shared --enable-static --disable-doc \
    --disable-gcc-warnings --prefix=$PREFIX && \
    make -j$(nproc) && make install && cd .. && rm -rf libidn2-*

RUN git clone --recursive https://github.com/rockdaboot/libpsl.git
RUN cd libpsl && \
    ./autogen.sh && \
    ./configure --disable-shared --enable-static \
    --enable-runtime=libidn2 --enable-builtin --prefix=$PREFIX && \
    make -j$(nproc) && make install && cd .. && rm -rf libpsl

RUN git clone https://github.com/zlib-ng/zlib-ng
RUN cd zlib-ng && \
	CFLAGS="-O2" \
	./configure --prefix=$PREFIX --static --zlib-compat && \
	make -j$(nproc) && make install && cd .. && rm -rf zlib-ng

# libtool's "-static" only statically links libtool libraries; the second
# "--static" is passed through to gcc and is what makes the binary static.
# gnutls.pc does not list nettle/hogweed in Requires.private, so a static link
# against libgnutls.a needs them passed explicitly via LIBS.
RUN git clone https://gitlab.com/gnuwget/wget2.git
RUN cd wget2 && ./bootstrap --skip-po && \
	LDFLAGS="-static --static" CFLAGS="-O2 -DNGHTTP2_STATICLIB" \
	LIBS="-lhogweed -lnettle -lgmp" \
	PKG_CONFIG="pkg-config --static" \
	./configure --disable-shared --enable-static --without-gpgme && \
	make -j$(nproc) && \
	make install && \
	cd .. && rm -rf wget2
